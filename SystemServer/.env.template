# ============================================
# OpenAI API Configuration
# ============================================
# OpenAI API キーを設定してください
OPENAI_API_KEY=sk-your-api-key-here

# ============================================
# xArm Robot Configuration
# ============================================
# xArmロボット機能を有効にするか (true/false)a
# デフォルト: true
XARM_ENABLE=false

# xArmロボットのIPアドレス
# デフォルト: 192.168.1.199
XARM_IP=192.168.1.199

# ============================================
# Server Configuration (Optional)
# ============================================
# サーバのホストアドレス
# SERVER_HOST=0.0.0.0

# サーバのポート
# SERVER_PORT=8765

# ============================================
# Logging Configuration (Optional)
# ============================================
# ログレベル (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO
